#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

staged_go=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if [ -z "$staged_go" ]; then
    exit 0
fi

echo -e "${YELLOW}[pre-commit] Running go vet...${NC}"
if ! go vet ./...; then
    echo -e "${RED}[pre-commit] go vet failed${NC}"
    exit 1
fi

if command -v golangci-lint &>/dev/null; then
    echo -e "${YELLOW}[pre-commit] Running golangci-lint...${NC}"
    if ! golangci-lint run --timeout=3m; then
        echo -e "${RED}[pre-commit] golangci-lint failed${NC}"
        exit 1
    fi
fi

echo -e "${YELLOW}[pre-commit] Running goimports...${NC}"
gofmt_files=$(gofmt -l $staged_go)
if [ -n "$gofmt_files" ]; then
    echo -e "${RED}[pre-commit] Files not formatted:${NC}"
    echo "$gofmt_files"
    echo -e "${YELLOW}[pre-commit] Run 'gofmt -w .' to fix${NC}"
    exit 1
fi

echo -e "${YELLOW}[pre-commit] Running tests...${NC}"
if ! go test ./... -count=1; then
    echo -e "${RED}[pre-commit] Tests failed${NC}"
    exit 1
fi

echo -e "${GREEN}[pre-commit] All checks passed${NC}"
