#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')

if [ -z "$staged_go" ]; then
    exit 0
fi

stash_created=false
restore_unstaged() {
    exit_code=$?

    if [ "$stash_created" = true ]; then
        if ! git stash pop --quiet; then
            echo -e "${RED}[pre-commit] Failed to restore unstaged changes. Resolve the stash manually.${NC}"
            exit 1
        fi
    fi

    exit "$exit_code"
}
trap restore_unstaged EXIT

if ! git diff --quiet --ignore-submodules -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo -e "${YELLOW}[pre-commit] Temporarily hiding unstaged changes...${NC}"
    git stash push --quiet --keep-index --include-untracked -m "pre-commit unstaged backup"
    stash_created=true
fi

staged_dirs=$(printf '%s\n' "$staged_go" | while IFS= read -r file; do
    dir=$(dirname "$file")
    if [ "$dir" = "." ]; then
        echo "."
    else
        echo "./$dir"
    fi
done | sort -u)

if command -v golangci-lint &>/dev/null; then
    echo -e "${YELLOW}[pre-commit] Formatting staged Go files with golangci-lint...${NC}"
    if ! golangci-lint fmt $staged_dirs; then
        echo -e "${RED}[pre-commit] Format failed${NC}"
        exit 1
    fi
    git add -- $staged_go

    echo -e "${YELLOW}[pre-commit] Running golangci-lint...${NC}"
    if ! golangci-lint run --timeout=3m $staged_dirs; then
        echo -e "${RED}[pre-commit] golangci-lint failed${NC}"
        exit 1
    fi
fi

echo -e "${GREEN}[pre-commit] All checks passed${NC}"
